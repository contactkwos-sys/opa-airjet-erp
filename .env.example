WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
CEO_WHATSAPP_NUMBER=919999999999
CEO_APPROVAL_TOKEN_SECRET=change_me_to_a_long_random_secret
APP_BASE_URL=https://your-erp-domain.com
